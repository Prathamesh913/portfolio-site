# Currently section — server-side secrets (never commit real values).
# Local dev: copy to .env.local (git-ignored). Production: set in
# Vercel Project Settings → Environment Variables, or Netlify
# Site Settings → Environment Variables.

# Trakt — https://trakt.tv/oauth/applications
# Run `npm run trakt:auth` once to mint user tokens (same one-time pattern as
# Spotify). The server sends both the api-key and the Bearer token; the
# Recently Watched section and the Currently card share these credentials.
# Redirect URI: http://127.0.0.1:3000/trakt-callback
#
# ⚠️ MAINTENANCE LIMITATION — Trakt access tokens expire after 7 days, and
# refresh tokens are SINGLE-USE: every refresh returns a new refresh_token and
# immediately invalidates the old one. This deployment has no durable store for
# the rotated token, so at roughly weekly intervals re-run `npm run trakt:auth`
# (or whenever /api/trakt/recent returns "traktReauthRequired": true).
# Failure is graceful: cached items are served, then the section hides; the
# rest of the portfolio is unaffected. Proper fix: a small KV store
# (Vercel KV / Upstash) holding the rotating token.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://127.0.0.1:3000/trakt-callback
TRAKT_ACCESS_TOKEN=
TRAKT_ACCESS_EXPIRES_AT=
TRAKT_REFRESH_TOKEN=
# Number of recent history items rendered (1–24, default 8).
TRAKT_HISTORY_LIMIT=8

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI for the one-time auth step: http://127.0.0.1:3000/callback
# Scopes: user-read-currently-playing user-read-recently-played user-read-playback-state streaming user-modify-playback-state
# (streaming + user-modify-playback-state power tonearm playback via the Web
# Playback SDK — requires Spotify Premium on the account.)
# Fill in the two credentials below, then run `npm run spotify:auth` to mint
# the refresh token automatically (it writes SPOTIFY_REFRESH_TOKEN for you).
# NOTE (2026-07-20+): refresh tokens expire 6 months after authorization —
# re-run `npm run spotify:auth` twice a year, or when the API reports invalid_grant.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Hardcover — https://hardcover.app/account/api → New API Key
HARDCOVER_API_TOKEN=

# GitHub activity — contribution calendar via the GraphQL API (REST has no
# calendar endpoint, so a token is required even for public profiles).
# Create a fine-grained PAT with zero permissions (public data only) at
# https://github.com/settings/tokens?type=beta — or a classic PAT with no
# scopes at https://github.com/settings/tokens. Never commit the value.
GITHUB_TOKEN=
GITHUB_USERNAME=Prathamesh913
